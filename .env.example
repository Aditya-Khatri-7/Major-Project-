# Copy to .env and fill in. Every variable is declared in config.py; unknown keys are ignored.

ANTHROPIC_API_KEY=your_key_here
LLM_MODEL_ID=claude-sonnet-5-5

# Local models (produced by the training scripts)
TEXT_DL_MODEL_PATH=models/text_dl_v2
IMAGE_MODEL_PATH=models/efficientnet_b4.pt
CALIBRATION_PATH=models/calibration.json
SLM_OBSERVER_MODEL=Qwen/Qwen2.5-0.5B
SLM_PERFORMER_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# Runtime switches (also how you run single-tool experiments)
ENABLED_TEXT_TOOLS=dl,slm,llm
ENABLED_IMAGE_TOOLS=dl,clip,vlm
ENABLE_REFLEXION=true
IMAGE_TTA=false

# Storage
CHROMA_PERSIST_DIR=./chroma_data
EVIDENCE_DB_URL=sqlite:///evidence_store/forensics.db
JOBS_DIR=./jobs
LOG_LEVEL=INFO

# Note: HF_HOME (Hugging Face model cache) is read by the huggingface libraries from the real environment,
# not from this file. Set it in your shell to keep the cache off a small system drive, e.g. HF_HOME=D:\hf_cache
